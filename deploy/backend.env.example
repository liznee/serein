# serein 后端环境变量示例
# 复制为 .env 并填入真实值(用 scripts/gen-tokens.sh 生成 token)

# hook 认证 token(后端与 hook 脚本共享,必填)
HOOK_TOKEN=

# 设备首次配对码（必填，禁止使用默认值 serein-pair-me）
# 需同时设置给后端和 relay（serein.mjs），用于 QR 码嵌入配对信息
PAIR_CODE=

# ntfy 推送 topic（必填，使用不可预测的随机后缀，避免订阅碰撞）
NTFY_TOPIC=

# 审批超时秒数(默认 300=5min)
APPROVAL_TIMEOUT=300

# 公网 HTTPS 地址；启用 GitHub/Gitee OAuth 时必填，不要带末尾斜杠
PUBLIC_URL=

# 可选实验功能：社区 OAuth。不使用 GitHub/Gitee 时可留空。
# 凭证只放在 deploy/.env，禁止提交真实值。
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITEE_CLIENT_ID=
GITEE_CLIENT_SECRET=

# HarmonyOS 系统级后台通知（可选，但正式版后台审批通知建议启用）
# 在 AppGallery Connect 为 com.serein.client 开通 Push Kit 后填写。
# Client Secret 只能放在服务器 .env，禁止进入 App、日志或公开仓库。
HUAWEI_PUSH_CLIENT_ID=
HUAWEI_PUSH_CLIENT_SECRET=
